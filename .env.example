# Production-Oriented AI Voice Platform Configuration

# Environment
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Database & Cache (Defaults to SQLite for local standalone execution)
DATABASE_URL=sqlite:///./data/platform.db
REDIS_URL=redis://localhost:6379/0

# Knowledge Base & Retrieval
EMBEDDING_PROVIDER=local  # options: local, sentence-transformers, openai
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.65

# LLM Providers (Leave blank for deterministic local mock adapter)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# Voice Platform & Telephony Providers (Leave blank for local mock stream adapter)
VOICE_PROVIDER=mock  # options: mock, deepgram, elevenlabs, livekit
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Real-time Call Insights (Q4)
NUDGE_COOLDOWN_SECONDS=20
SIGNAL_CONFIDENCE_THRESHOLD=0.70
AUDIO_CHUNK_MS=250
